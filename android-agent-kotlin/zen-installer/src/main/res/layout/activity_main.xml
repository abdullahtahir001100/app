<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zenvora_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="48dp"
        android:paddingBottom="24dp">

        <!-- Zenvora Official Rings Logo -->
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_zenvora_rings" />

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ZENVORA"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textColor="@color/zenvora_primary"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/tvAppSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Device Setup &amp; Auto-Installer"
            android:textSize="13sp"
            android:textColor="@color/zenvora_muted"
            android:layout_marginTop="2dp" />

        <!-- Status & Live Download Card -->
        <LinearLayout
            android:id="@+id/cardStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_marginTop="32dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Preparing setup…"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/zenvora_text"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvSubStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Connecting to repository…"
                android:textSize="13sp"
                android:textColor="@color/zenvora_muted"
                android:gravity="center"
                android:layout_marginTop="6dp" />

            <!-- Progress row (Percent + Bytes) -->
            <RelativeLayout
                android:id="@+id/layoutProgressDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">

                <TextView
                    android:id="@+id/tvProgressPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="0%"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/zenvora_text" />

                <TextView
                    android:id="@+id/tvBytesProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="0 MB / 0 MB"
                    android:textSize="12sp"
                    android:textColor="@color/zenvora_muted" />
            </RelativeLayout>

            <!-- Horizontal Progress Bar -->
            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/zenvora_primary"
                android:layout_marginTop="8dp" />

            <!-- Action button (e.g. Permission / Open) -->
            <Button
                android:id="@+id/btnAction"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Grant Install Permission"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/zenvora_on_primary"
                android:backgroundTint="@color/zenvora_primary"
                android:layout_marginTop="18dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Manual Token Setup Toggle -->
        <TextView
            android:id="@+id/btnToggleManual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙ Enter Token Manually"
            android:textColor="@color/zenvora_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:padding="10dp"
            android:layout_marginTop="20dp" />

        <!-- Manual Token Verification Card -->
        <LinearLayout
            android:id="@+id/layoutManual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Manual Token Verification"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/zenvora_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enter your pairing token or code from the Zenvora Dashboard. Server connection is verified automatically."
                android:textSize="12sp"
                android:textColor="@color/zenvora_muted"
                android:layout_marginTop="4dp" />

            <EditText
                android:id="@+id/etPairToken"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:hint="Enter Token (e.g. 6-digit code or token)"
                android:textColor="@color/zenvora_text"
                android:textColorHint="@color/text_hint"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/tvManualError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/zenvora_error"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_marginTop="6dp" />

            <Button
                android:id="@+id/btnVerifyToken"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Verify Token &amp; Install"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/zenvora_on_primary"
                android:backgroundTint="@color/zenvora_primary"
                android:layout_marginTop="12dp" />

        </LinearLayout>

        <!-- Empty spacer to push footer down -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="32dp" />

        <!-- Footer -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enterprise Security &amp; Device Management"
            android:textSize="11sp"
            android:textColor="@color/zenvora_muted"
            android:layout_marginBottom="12dp" />

    </LinearLayout>
</ScrollView>
