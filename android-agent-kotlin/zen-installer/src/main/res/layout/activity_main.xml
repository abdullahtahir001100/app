<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="32dp">

    <!-- Logo / Icon area -->
    <TextView
        android:id="@+id/tvIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚙"
        android:textSize="64sp"
        android:textColor="@color/accent_blue"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintBottom_toTopOf="@+id/tvAppName"
        android:layout_marginTop="80dp" />

    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:letterSpacing="0.05"
        app:layout_constraintTop_toBottomOf="@+id/tvIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp" />

    <!-- Main status text -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Initializing…"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:layout_marginTop="60dp"
        app:layout_constraintTop_toBottomOf="@+id/tvAppName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Sub-status / description -->
    <TextView
        android:id="@+id/tvSubStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:lineSpacingMultiplier="1.5"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@+id/tvStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Progress bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:indeterminate="true"
        android:progressTint="@color/accent_blue"
        android:indeterminateTint="@color/accent_blue"
        android:layout_marginTop="28dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/tvSubStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Action button -->
    <Button
        android:id="@+id/btnAction"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:text="Allow Installation"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:textColor="@color/white"
        android:backgroundTint="@color/accent_blue"
        android:layout_marginTop="36dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/progressBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Manual Setup Toggle Button -->
    <TextView
        android:id="@+id/btnToggleManual"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚙ Manual Server / Token Setup"
        android:textColor="@color/accent_blue"
        android:textSize="13sp"
        android:padding="8dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/btnAction"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Manual Setup Section (Optional) -->
    <LinearLayout
        android:id="@+id/layoutManual"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:padding="12dp"
        android:background="#1A2536"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/btnToggleManual"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/etServerUrl"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="Server URL (e.g. https://zenvora.app)"
            android:textColor="@color/white"
            android:textColorHint="@color/text_hint"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/etPairToken"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="Pairing Token / Code"
            android:textColor="@color/white"
            android:textColorHint="@color/text_hint"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/btnSaveManual"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Save &amp; Connect"
            android:textSize="13sp"
            android:backgroundTint="@color/accent_blue"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Bottom caption -->
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/bottom_caption"
        android:textSize="11sp"
        android:textColor="@color/text_hint"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="24dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
